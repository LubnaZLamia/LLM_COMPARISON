# run.bat creates .env from this file and asks for your key.
# You can also copy it to `.env` and edit it by hand.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
OPENROUTER_TIMEOUT=90

# Retries for temporary failures (rate limits, provider hiccups, timeouts)
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_RETRY_BACKOFF=1.0

# Judge model for "Score with judge model" (an OpenRouter id, e.g. anthropic/claude-sonnet-4.5).
# Leave blank to use the model marked "is judge" in /admin.
JUDGE_MODEL=

# --- How the clinician comparison is scored ---------------------------------
# lexical = word overlap only (the original baseline)
# meaning = a small model aligns the two texts, so a paraphrase still counts
# both    = compute both and show them side by side
MATCH_METHOD=both

# Model that does the alignment (an OpenRouter id). Blank picks a cheap active one.
MATCH_MODEL=

# Word-overlap baseline only: share of a clinician question's words that must appear in a
# model question for it to count as asked. Lower is more generous (0.4-0.6 is sensible).
GT_MATCH_RECALL=0.5

# Chat: how many recent messages the model sees with each new message
CHAT_HISTORY_MESSAGES=20

# Peer annotation: how many people should annotate each output (2 = enough for agreement)
ANNOTATION_TARGET=2

# Set to true to try the app with fake outputs (no API calls, no cost)
LLM_MOCK_MODE=false

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
