# run.bat creates .env from this file and asks for your key.
# You can also copy it to `.env` and edit it by hand.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
OPENROUTER_TIMEOUT=90

# Judge model for "Score with judge model" (an OpenRouter id, e.g. anthropic/claude-sonnet-4.5).
# Leave blank to use the model marked "is judge" in /admin.
JUDGE_MODEL=

# Compare against dataset reference answers too (for later, once you have ground-truth datasets)
SHOW_REFERENCE_METRICS=false

# Set to true to try the app with fake outputs (no API calls, no cost)
LLM_MOCK_MODE=false

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
